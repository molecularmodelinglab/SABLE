FROM mambaorg/micromamba:1.5.8

ARG MAMBA_DOCKERFILE_ACTIVATE=1
SHELL ["/bin/bash", "-lc"]

# LABEL org.opencontainers.image.title="LIZARD"
# LABEL org.opencontainers.image.description="LIgand optimiZation via Agentic Research and Discovery"
# LABEL org.opencontainers.image.source="https://github.com/molecularmodelinglab/LIZARD"

RUN micromamba create -y -n lizard -c conda-forge \
    python=3.12 \
    rdkit \
    pip \
    git \
 && micromamba clean -a -y

ENV PATH=/opt/conda/envs/lizard/bin:$PATH
ENV PYTHONUNBUFFERED=1

ENV HOME=/app
ENV MAMBA_CACHE_DIR=/app/.cache/mamba

WORKDIR /app

USER root


COPY requirements.txt ./
COPY constraints-cpu.txt ./
RUN grep -viE '^(rdkit\b|.*git\+.*healer.*)' requirements.txt > /tmp/requirements.base.txt || true \
 && micromamba run -n lizard python -m pip install --upgrade pip \
 && micromamba run -n lizard python -m pip install --no-cache-dir -r /tmp/requirements.base.txt --constraint constraints-cpu.txt \
 && rm -f /tmp/requirements.base.txt

ENV HEALER_DATA_DIR=/app/building_blocks

COPY --chown=$MAMBA_USER:$MAMBA_USER . .

# (OpenShift-compatible)
RUN mkdir -p /app/data /app/logs /app/checkpoints \
    && chown -R "$MAMBA_USER":0 /app \
    && chmod -R g+rwX /app

USER 1001

ENTRYPOINT ["bash", "/app/docker/entrypoint.sh"]

CMD []
