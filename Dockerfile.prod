FROM mambaorg/micromamba:1.5.8

ARG MAMBA_DOCKERFILE_ACTIVATE=1
SHELL ["/bin/bash", "-lc"]

# LABEL org.opencontainers.image.title="SABLE"
# LABEL org.opencontainers.image.description="Synthetically-accessible Agentic Bayesian Ligand Exploration"
# LABEL org.opencontainers.image.source="https://github.com/molecularmodelinglab/SABLE"

RUN micromamba create -y -n sable -c conda-forge \
    python=3.12 \
    rdkit \
    pip \
    git \
 && micromamba clean -a -y

ENV PATH=/opt/conda/envs/sable/bin:$PATH
ENV PYTHONUNBUFFERED=1

ENV HOME=/app
ENV MAMBA_CACHE_DIR=/app/.cache/mamba

WORKDIR /app

USER root

RUN micromamba run -n sable python -m pip install --upgrade pip \
 && micromamba run -n sable python -m pip install --no-cache \
    torch==2.8.0 \
    --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt ./
COPY constraints-cpu.txt ./
RUN grep -viE '^(rdkit\b)' requirements.txt > /tmp/requirements.base.txt || true \
 && micromamba run -n sable python -m pip install --no-cache-dir -r /tmp/requirements.base.txt --constraint constraints-cpu.txt \
 && rm -f /tmp/requirements.base.txt


ENV HEALER_DATA_DIR=/app/building_blocks

COPY --chown=$MAMBA_USER:$MAMBA_USER . .

# (OpenShift-compatible)
RUN mkdir -p /app/data /app/logs /app/checkpoints \
    && chown -R "$MAMBA_USER":0 /app \
    && chmod -R g+rwX /app

USER 1001

ENTRYPOINT ["bash", "/app/docker/entrypoint.sh"]

CMD []
