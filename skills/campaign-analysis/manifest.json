{
  "schema_version": 1,
  "id": "campaign-analysis",
  "version": "1.1.0",
  "description": "Analyze recorded molecular observations: property distributions, progress by scientific round, or chemical-space PCA; produce sourced summaries, interactive chart data, and downloadable PNG/SVG figures and interactive Plotly views with SVG export.",
  "operations": [
    {
      "id": "analyze",
      "handler": "analyze",
      "description": "Generate an analysis from recorded observation action IDs. Routine tables and molecule drawings already appear automatically in the UI.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "measurement_action_ids",
          "property",
          "chart",
          "direction"
        ],
        "properties": {
          "measurement_action_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 64
            }
          },
          "property": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "chart": {
            "enum": [
              "distribution",
              "progress",
              "chemical_space",
              "box",
              "violin",
              "minmax"
            ]
          },
          "direction": {
            "enum": [
              "MIN",
              "MAX"
            ]
          }
        }
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "source_action_ids",
          "summary",
          "figure_png_base64",
          "presentation",
          "method",
          "observation_method"
        ],
        "properties": {
          "kind": {
            "const": "campaign_analysis"
          },
          "source_action_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "summary": {
            "type": "object"
          },
          "figure_png_base64": {
            "type": "string",
            "maxLength": 2000000,
            "pattern": "^[A-Za-z0-9+/=]+$"
          },
          "presentation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "version": {
                "const": 1
              },
              "title": {
                "type": "string",
                "maxLength": 1000
              },
              "summary": {
                "type": "string",
                "maxLength": 1000
              },
              "blocks": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "table"
                        },
                        "title": {
                          "type": "string",
                          "maxLength": 1000
                        },
                        "columns": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "key": {
                                "type": "string",
                                "maxLength": 1000
                              },
                              "label": {
                                "type": "string",
                                "maxLength": 1000
                              }
                            },
                            "required": [
                              "key",
                              "label"
                            ]
                          },
                          "maxItems": 100
                        },
                        "rows": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": {
                              "type": [
                                "string",
                                "number",
                                "boolean",
                                "null"
                              ]
                            }
                          },
                          "maxItems": 10000
                        }
                      },
                      "required": [
                        "type",
                        "title",
                        "columns",
                        "rows"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "molecules"
                        },
                        "title": {
                          "type": "string",
                          "maxLength": 1000
                        },
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "id": {
                                "type": "string",
                                "maxLength": 1000
                              },
                              "smiles": {
                                "type": "string",
                                "maxLength": 2048
                              },
                              "label": {
                                "type": "string",
                                "maxLength": 1000
                              }
                            },
                            "required": [
                              "id",
                              "smiles"
                            ]
                          },
                          "maxItems": 1000
                        }
                      },
                      "required": [
                        "type",
                        "title",
                        "items"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "type": {
                          "const": "chart"
                        },
                        "title": {
                          "type": "string",
                          "maxLength": 1000
                        },
                        "style": {
                          "enum": [
                            "line",
                            "scatter",
                            "distribution"
                          ]
                        },
                        "x_label": {
                          "type": "string",
                          "maxLength": 1000
                        },
                        "y_label": {
                          "type": "string",
                          "maxLength": 1000
                        },
                        "points": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "x": {
                                "type": "number"
                              },
                              "y": {
                                "type": "number"
                              },
                              "label": {
                                "type": "string",
                                "maxLength": 1000
                              }
                            },
                            "required": [
                              "x",
                              "y"
                            ]
                          },
                          "maxItems": 10000
                        }
                      },
                      "required": [
                        "type",
                        "title",
                        "style",
                        "x_label",
                        "y_label",
                        "points"
                      ]
                    }
                  ]
                },
                "maxItems": 12
              }
            },
            "required": [
              "version",
              "title",
              "summary",
              "blocks"
            ]
          },
          "method": {
            "type": "string"
          },
          "observation_method": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "figure_svg": {
            "type": "string",
            "maxLength": 3000000
          },
          "figure_html": {
            "type": "string",
            "maxLength": 3000000
          }
        }
      }
    }
  ],
  "workers": {
    "plot": {
      "file": "worker.py",
      "handler": "plot",
      "timeout_seconds": 120
    }
  },
  "requirements": {
    "modules": [
      "numpy",
      "pandas",
      "matplotlib",
      "plotly",
      "rdkit",
      "sklearn"
    ]
  }
}
