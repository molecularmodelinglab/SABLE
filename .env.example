# LIZARD Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://lizard_user:your_secure_postgres_password_here@localhost:5432/lizard

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_URL=redis://:your_secure_redis_password_here@localhost:6379/0

# =============================================================================
# Application Configuration
# =============================================================================
SECRET_KEY=your_secret_key_for_jwt_signing_at_least_32_characters_long
ENVIRONMENT=development
# Options: development, staging, production

# Session settings
SESSION_EXPIRY_HOURS=24

# API settings
MAX_CONCURRENT_RUNS=5
RATE_LIMIT_PER_MINUTE=60

# SQL debugging (set to true to echo all SQL queries)
SQL_ECHO=false

# =============================================================================
# Authentication - Auth0 (Optional)
# =============================================================================
# Leave empty to use local email/password authentication only
# Fill these in if you want to enable Auth0 integration

AUTH0_DOMAIN=
# Example: your-tenant.auth0.com

AUTH0_CLIENT_ID=
# Your Auth0 application client ID

AUTH0_CLIENT_SECRET=
# Your Auth0 application client secret

AUTH0_AUDIENCE=
# Your Auth0 API audience identifier
# Example: https://api.yourdomain.com

# =============================================================================
# LLM Configuration (for argument extraction and conversational UI)
# =============================================================================
LLM_PROVIDER=gemini
# Options: openai, gemini

# OpenAI Configuration (if using OpenAI)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini Configuration (if using Gemini)
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Specify model versions
# OPENAI_MODEL=gpt-4-turbo
# GEMINI_MODEL=gemini-2.5-pro

# =============================================================================
# Boltz Configuration (for protein structure prediction)
# =============================================================================
BOLTZ_BASE_URL=
BOLTZ_API_TOKEN=

# =============================================================================
# Email Configuration (for verification emails)
# =============================================================================
# Optional: Configure if you want to send verification emails

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@yourdomain.com
SMTP_FROM_NAME=LIZARD

# =============================================================================
# Storage Configuration
# =============================================================================
# Root directory for data storage (run artifacts, checkpoints, results)
LIZARD_DATA_ROOT=./data

# Storage backend selector: local (default) or s3
LIZARD_STORAGE_BACKEND=local

# S3 configuration (required when LIZARD_STORAGE_BACKEND=s3)
LIZARD_STORAGE_S3_BUCKET=
# Prefix within the bucket for run artifacts
LIZARD_STORAGE_S3_PREFIX=runs/
# Optional KMS key for server-side encryption
LIZARD_STORAGE_S3_KMS_KEY_ID=

# =============================================================================
# Monitoring and Logging (Optional)
# =============================================================================
# Sentry DSN for error tracking
SENTRY_DSN=

# Log level
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# =============================================================================
# Development Settings
# =============================================================================
# Enable hot reload for development
RELOAD=true

# Enable CORS for local development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# Production Settings (uncomment for production deployment)
# =============================================================================
# ENVIRONMENT=production
# RELOAD=false
# SQL_ECHO=false
# CORS_ORIGINS=https://yourdomain.com
# SECURE_COOKIES=true
# HSTS_ENABLED=true
