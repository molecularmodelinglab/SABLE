# Copy to .env.production and replace every required value before deployment.
SABLE_IMAGE_TAG=latest
HTTP_PORT=80
HTTPS_PORT=443

# Public TLS settings. DNS must point SSL_DOMAIN to this host.
SSL_DOMAIN=
LETSENCRYPT_EMAIL=
# Use 1 while testing issuance to avoid Let's Encrypt rate limits.
LETSENCRYPT_STAGING=0

ENVIRONMENT=production

# Required secrets
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY=
PROVIDER_CREDENTIAL_MASTER_KEY=

# Optional authentication
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_CALLBACK_URL=

# Optional model providers
LLM_PROVIDER=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional Boltz service
BOLTZ_BASE_URL=
BOLTZ_API_TOKEN=
BOLTZ_EXECUTION_MODE=api

# Optional HPC execution
HPC_HOST=
HPC_USER=
HPC_PASSWORD=
HPC_SSH_KEY=
HPC_SSH_KEY_CONTENT=
REMOTE_BASE_DIR=
BOLTZ_RESOURCES_DIR=

# Application tuning
MAX_CONCURRENT_RUNS=5
MOLECULAR_FP=MORDRED
MULTI_OPT_TYPE=pareto
HEALER_EXECUTION_MODE=internal
HEALER_ENDPOINT=
HEALER_STOCK=US_stock
HEALER_POLL_INTERVAL_SECONDS=2
HEALER_JOB_TIMEOUT_SECONDS=900
HEALER_HTTP_TIMEOUT_SECONDS=30

# Same-origin Nginx deployments can leave this empty.
CORS_ORIGINS=

# Durable run storage. Prefer the VM's managed identity in Azure.
SABLE_STORAGE_BACKEND=azure
AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER=sable-artifacts
SABLE_STORAGE_AZURE_PREFIX=runs/
# Local/non-Azure fallback only. Leave empty when using managed identity.
AZURE_STORAGE_CONNECTION_STRING=