# Copy to .env.production and replace every required value before deployment.
SABLE_IMAGE_TAG=latest
HTTP_PORT=80
HTTPS_PORT=443

# Public TLS settings. DNS must point SSL_DOMAIN to this host.
SSL_DOMAIN=
LETSENCRYPT_EMAIL=
# Use 1 while testing issuance to avoid Let's Encrypt rate limits.
LETSENCRYPT_STAGING=0

ENVIRONMENT=production

# Required secrets
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY=
PROVIDER_CREDENTIAL_MASTER_KEY=

# Optional authentication
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_CALLBACK_URL=

# Optional model providers
LLM_PROVIDER=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENAI_MODEL=gpt-5-chat
GEMINI_MODEL=gemini-2.5-pro

# Optional Boltz service
BOLTZ_BASE_URL=
BOLTZ_API_TOKEN=
BOLTZ_EXECUTION_MODE=api

# OpenFE execution profile (must exist on the hosted OpenFE service)
OPENFE_BASE_URL=
OPENFE_API_TOKEN=
OPENFE_POLL_INTERVAL=10
OPENFE_WAIT_TIMEOUT=3600
OPENFE_EXECUTION_PROFILE=local

# Optional HPC execution
HPC_HOST=
HPC_USER=
HPC_PASSWORD=
HPC_SSH_KEY=
HPC_SSH_KEY_CONTENT=
REMOTE_BASE_DIR=
BOLTZ_RESOURCES_DIR=

# Application tuning
MAX_CONCURRENT_RUNS=5
MOLECULAR_FP=MORDRED
MULTI_OPT_TYPE=pareto
HEALER_EXECUTION_MODE=internal
HEALER_ENDPOINT=
HEALER_STOCK=US_stock
HEALER_POLL_INTERVAL_SECONDS=2
HEALER_JOB_TIMEOUT_SECONDS=900
HEALER_HTTP_TIMEOUT_SECONDS=30

# Same-origin Nginx deployments can leave this empty.
CORS_ORIGINS=

# Durable run storage. Prefer the VM's managed identity in Azure.
SABLE_STORAGE_BACKEND=azure
AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.blob.core.windows.net
AZURE_STORAGE_CONTAINER=sable-artifacts
SABLE_STORAGE_AZURE_PREFIX=runs/
# Local/non-Azure fallback only. Leave empty when using managed identity.
AZURE_STORAGE_CONNECTION_STRING=
# Agent campaigns share the PostgreSQL DATABASE_URL used for accounts.
# Run alembic upgrade head before starting the API or campaign job worker.
SABLE_AGENT_ENABLED=0
# Maximum total budgets an owner may explicitly approve for a campaign.
SABLE_MAX_CAMPAIGN_DECISIONS=1000
SABLE_MAX_CAMPAIGN_ACTIONS=200
SABLE_MAX_CAMPAIGN_UNITS=500

# Non-secret environment names approved for skill subprocesses.
SABLE_WORKER_ENV_ALLOWLIST=HEALER_DATA_DIR

# Absolute in-container path to deployment-owned remote service bindings JSON.
SABLE_SERVICE_BINDINGS_PATH=

# Optional absolute path to the managed immutable skill store. Empty uses bundled skills.
SABLE_SKILL_STORE_PATH=

# Service binding endpoints are resolved from these variables and the existing
# HEALER_ENDPOINT, BOLTZ_BASE_URL and OPENFE_BASE_URL settings above.
# Set those base URLs for each service included in your bindings file.
STOPLIGHT_URL=https://stoplight.mml.unc.edu/smiles-csv

# Enumeration breadth is independent of evaluation batch size and iterations.
HEALER_MAX_TOTAL_PRODUCTS=8000
HEALER_N_COMPOSITIONS=100
HEALER_MAX_BBS_PER_FRAG=10
SABLE_MAX_ENUMERATION_PRODUCTS=20000

# CAS Common Chemistry API access; keep the key out of prompts and source control.
CAS_API_KEY=
