# HPC Configuration Example
# Copy this to .env and modify for setup

# HPC connection details
HPC_HOST=longleaf.unc.edu
HPC_USER=username
HPC_SSH_KEY=/home/user/.ssh/id_rsa

# Remote paths on HPC
REMOTE_BASE_DIR=/nas/users/username/boltz/jobs
BOLTZ_RESOURCES_DIR=/nas/users/username/boltz/2.2.1
BOLTZ_CACHE_DIR_REMOTE=/nas/users/username/.boltz

# Local paths
OUTPUT_DIR=./hpc_outputs

# Slurm configuration
SLURM_TEMPLATE=./boltz_template.sh

# API security
API_TOKEN=secure_api_token_here

# Optional: Testing
TEST_ALLOW_FIXED_JOB_ID=false